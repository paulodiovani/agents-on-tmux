[0.016, "o", "\u001b[2;37H\u001b[38;2;210;150;31m[Extension issues]\u001b[39m\u001b[K\u001b[3;37H\u001b[38;2;210;150;31m  ~/.pi/agent/npm/node_modules/pi-lens/package.json\u001b[39m\u001b[K\u001b[4;37H\u001b[38;2;210;150;31m    Host-provided extension packages must be declared in peerDependencies with a \"*\" range, not        \u001b[5;37Hdependencies: @earendil-works/pi-tui, typebox. Installed copies can bypass the extension loader and    \u001b[6;37Hcreate duplicate runtime modules.\u001b[39m\u001b[K\u001b[9;37H \u001b[38;2;210;150;31mWarning: Extension package \"/home/diovani/.pi/agent/npm/node_modules/pi-lens/package.json\":\u001b[39m\u001b[K\u001b[10;37H \u001b[38;2;210;150;31mHost-provided extension packages must be declared in peerDependencies with a \"*\" range, not\u001b[39m\u001b[K\u001b[11;37H \u001b[38;2;210;150;31mdependencies: @earendil-works/pi-tui, typebox. Installed copies can bypass the extension loader and   \u001b[12;37H\u001b[39m \u001b[38;2;210;150;31mcreate duplicate runtime modules.\u001b[39m\u001b[K\u001b[14;37H\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[15;37H\u001b[39m \u001b[38;2;210;150;31m\u001b[1mPackage Updates Available\u001b(B\u001b[m\u001b[K\u001b[16;37H \u001b[38;2;170;160;153mPackage updates are available. Run \u001b(B\u001b[m\u001b[38;2;203;141;168mpi update --extensions\u001b[39m\u001b[K\u001b[17;37H \u001b[38;2;170;160;153mPackages:\u001b[39m\u001b[K\u001b[18;37H - pi-lens\u001b[K\u001b[19;37H - pi-powerline\u001b[K\u001b[20;37H\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[22;37H\u001b[39m\u001b[48;2;37;59;60m                                                                                                       \u001b[23;37H explain this project                                                                                  \u001b[24;37H                 