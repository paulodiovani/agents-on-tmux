[0.003, "o", "\u001b[2;10H\u001b[1m1\r\n\u001b(B\u001b[m\u001b[100m\u001b[2m▔\u001b(B\u001b[m\u001b[34m\u001b[100m▔▔▔▔▔▔▔▔▔▔\u001b[39m\u001b[2m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\r\n\u001b(B\u001b[m\u001b[100m \u001b[34m* \u001b[39m\u001b[1mpi\u001b(B\u001b[m\u001b[100m                        41s   \r\n  Pi       ~/D/R/agents-on-tmux   \r\n\u001b[49m\u001b[90m▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\r\n\u001b[39m                                   \r\n                                   \r\n                                   \u001b[36;2H\u001b[1m↑↓\u001b(B\u001b[m\u001b[2m navigate\u001b(B\u001b[m  \u001b[1m→\u001b(B\u001b[m\u001b[2m windows\u001b[2C\u001b(B\u001b[m\u001b[1m⏎\u001b(B\u001b[m\u001b[2m focus\u001b[37;2H\u001b(B\u001b[m\u001b[1mc\u001b(B\u001b[m\u001b[2m new\u001b[2C\u001b(B\u001b[m\u001b[1m,\u001b(B\u001b[m\u001b[2m rename\u001b[2C\u001b(B\u001b[m\u001b[1md\u001b(B\u001b[m\u001b[2m kill\u001b[2C\u001b(B\u001b[m\u001b[1mq\u001b(B\u001b[m\u001b[2m quit\u001b(B\u001b[m"]
