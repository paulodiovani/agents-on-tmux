────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.018, "o", "\u001b[1;37H The backend handles the low-level communication with tmux.\u001b[K\u001b[2;37H \u001b[38;2;203;142;168m- \u001b[1mTmux\u001b[39m Trait:\u001b(B\u001b[m Defines a clean contract for managing sessions, windows, panes, and key bindings.       \u001b[3;37H \u001b[38;2;203;142;168m- \u001b[1mTmuxDriver\u001b[39m:\u001b(B\u001b[m The implementation that executes shell commands. It uses a \u001b[38;2;203;142;168mCommandExecutor\u001b[39m trait, which \u001b[4;37H   allows the project to use a \u001b[38;2;203;142;168mShellCommandExecutor\u001b[39m for production and a mock executor for unit        \u001b[5;37H   testing (essential for testing tmux logic without actually needing a tmux server running).\u001b[K\u001b[6;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[7;37H   whether it has pending notifications.\u001b[K\u001b[8;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[10;37H\u001b[K\n The project provides a TUI for interacting with the agents.\u001b[K\u001b[12;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[13;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[14;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[15;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[16;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[17;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[19;37H\u001b[K\n \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[21;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[22;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[23;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[24;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[25;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[26;37H       nested session.\u001b[K\u001b[27;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[28;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[29;37H    isolated tmux server.\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠇\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.017, "o", "\u001b[1;37H \u001b[38;2;203;142;168m- \u001b[1mTmuxDriver\u001b[39m:\u001b(B\u001b[m The implementation that executes shell commands. It uses a \u001b[38;2;203;142;168mCommandExecutor\u001b[39m trait, which \u001b[2;37H   allows the project to use a \u001b[38;2;203;142;168mShellCommandExecutor\u001b[39m for production and a mock executor for unit        \u001b[3;37H   testing (essential for testing tmux logic without actually needing a tmux server running).\u001b[K\u001b[4;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[5;37H   whether it has pending notifications.\u001b[K\u001b[6;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[9;37H The project provides a TUI for interacting with the agents.\u001b[K\u001b[10;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[11;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[12;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[13;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[14;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[15;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[18;37H \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[19;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[20;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[21;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[22;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[23;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[24;37H       nested session.\u001b[K\u001b[25;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[26;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[27;37H    isolated tmux server.\u001b[K\u001b[28;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Summary for\u001b(B\u001b[m\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠇\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.018, "o", "\u001b[1;37H   testing (essential for testing tmux logic without actually needing a tmux server running).\u001b[K\u001b[2;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[3;37H   whether it has pending notifications.\u001b[K\u001b[4;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[7;37H The project provides a TUI for interacting with the agents.\u001b[K\u001b[8;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[9;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[10;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[11;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[12;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[13;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[16;37H \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[17;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[18;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[19;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[20;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[21;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[22;37H       nested session.\u001b[K\u001b[23;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[24;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[25;37H    isolated tmux server.\u001b[K\u001b[26;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Summary for Developers\u001b(B\u001b[m\u001b[K\u001b[29;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mLanguage:\u001b(B\u001b[m Rust.\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠇\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.017, "o", "\u001b[1;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[2;37H   whether it has pending notifications.\u001b[K\u001b[3;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[5;37H\u001b[K\n The project provides a TUI for interacting with the agents.\u001b[K\u001b[7;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[8;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[9;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[10;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[11;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[12;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[14;37H\u001b[K\n \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[16;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[17;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[18;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[19;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[20;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[21;37H       nested session.\u001b[K\u001b[22;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[23;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[24;37H    isolated tmux server.\u001b[K\u001b[25;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Summary for Developers\u001b(B\u001b[m\u001b[K\u001b[27;37H\u001b[K\n \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mLanguage:\u001b(B\u001b[m Rust.\u001b[K\u001b[29;37H \u001b[38;2;203;142;168m- \u001b[39m**Design Philosophy\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠇\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.015, "o", "\u001b[1;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[2;37H   whether it has pending notifications.\u001b[K\u001b[4;37H \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[6;37H The project provides a TUI for interacting with the agents.\u001b[K\u001b[7;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[8;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[9;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[10;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[11;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[13;37H \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[15;37H \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[16;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[17;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[18;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[19;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[20;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[21;37H       nested session.\u001b[K\u001b[22;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[23;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[24;37H    isolated tmux server.\u001b[K\u001b[26;37H \u001b[38;2;210;150;31m\u001b[1m### Summary for Developers\u001b(B\u001b[m\u001b[K\u001b[28;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mLanguage:\u001b(B\u001b[m Rust.\u001b[K\u001b[29;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mDesign Philosophy:\u001b(B\u001b[m Trait\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠏\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[16D"]
[0.019, "o", "\u001b[1;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mAgent Management:\u001b(B\u001b[m It tracks \u001b[38;2;203;142;168mWindow\u001b[39m states, including which command is running, when it started, and \u001b[2;37H   whether it has pending notifications.\u001b[K\u001b[4;37H \u001b[38;2;210;150;31m\u001b[1m#### 3. The Frontend (\u001b(B\u001b[m\u001b[38;2;203;142;168msrc/frontends/\u001b(B\u001b[m\u001b[38;2;210;150;31m\u001b[1m)\u001b(B\u001b[m\u001b[K\u001b[6;37H The project provides a TUI for interacting with the agents.\u001b[K\u001b[7;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[8;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[9;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[10;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[11;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[13;37H \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[15;37H \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[16;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[17;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[18;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[19;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b