[0.001, "o", "\u001b[1;37H \u001b[38;2;210;150;31mcreate duplicate runtime modules.\u001b[39m\u001b[K\u001b[2;37H\u001b[K\n\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[4;37H\u001b[39m \u001b[38;2;210;150;31m\u001b[1mPackage Updates Available\u001b(B\u001b[m\u001b[K\u001b[5;37H \u001b[38;2;170;160;153mPackage updates are available. Run \u001b(B\u001b[m\u001b[38;2;203;141;168mpi update --extensions\u001b[39m\u001b[K\u001b[6;37H \u001b[38;2;170;160;153mPackages:\u001b[39m\u001b[K\u001b[7;37H - pi-lens\u001b[K\u001b[8;37H - pi-powerline\u001b[K\u001b[9;37H\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[10;37H\u001b[K\n\u001b[48;2;37;59;60m                                                                                                       \u001b[12;37H explain this project                                                                                  \u001b[13;37H                                                                                                       \u001b[49m\u001b[14;37H\u001b[K\n This project, \u001b[38;2;203;142;168m\u001b[1magents-on-tmux\u001b(B\u001b[m (binary name \u001b[38;2;203;142;168maot\u001b[39m), is a tool designed to manage a set of \"agents\"        \u001b[16;37H (long-running commands/processes) within a nested tmux environment.\u001b[K\u001b[17;37H\u001b[K\n Its primary goal is to allow a user to launch a predefined set of development tools or agents in      \u001b[19;37H isolated tmux windows/panes and manage them through a centralized TUI (Terminal User Interface),      \u001b[20;37H while avoiding the common \"freezing\" and session-detection issues that occur when nesting tmux        \u001b[21;37H sessions.\u001b[K\u001b[22;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Key Architecture & Features\u001b(B\u001b[m\u001b[K\u001b[24;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m#### 1. Isolated Tmux Server Architecture\u001b(B\u001b[m\u001b[K\u001b[26;37H\u001b[K\n The most distinctive technical feature is the use of a \u001b[1mseparate tmux server\u001b(B\u001b[m. Instead of creating a    \u001b[28;37H session on the default tmux server, \u001b[38;2;203;142;168maot\u001b[39m uses the \u001b[38;2;203;142;168m-L\u001b[39m socket option to start a completely isolated tmux \u001b[29;37H server instance\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠴\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[34;39H"]
[0.019, "o", "\u001b[1;37H\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[2;37H\u001b[39m \u001b[38;2;210;150;31m\u001b[1mPackage Updates Available\u001b(B\u001b[m\u001b[K\u001b[3;37H \u001b[38;2;170;160;153mPackage updates are available. Run \u001b(B\u001b[m\u001b[38;2;203;141;168mpi update --extensions\u001b[39m\u001b[K\u001b[4;37H \u001b[38;2;170;160;153mPackages:\u001b[39m\u001b[K\u001b[5;37H - pi-lens\u001b[K\u001b[6;37H - pi-powerline\u001b[K\u001b[7;37H\u001b[38;2;210;150;31m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[8;37H\u001b[K\n\u001b[48;2;37;59;60m                                                                                                       \u001b[10;37H explain this project                                                                                  \u001b[11;37H                                                                                                       \u001b[49m\u001b[12;37H\u001b[K\n This project, \u001b[38;2;203;142;168m\u001b[1magents-on-tmux\u001b(B\u001b[m (binary name \u001b[38;2;203;142;168maot\u001b[39m), is a tool designed to manage a set of \"agents\"        \u001b[14;37H (long-running commands/processes) within a nested tmux environment.\u001b[K\u001b[15;37H\u001b[K\n Its primary goal is to allow a user to launch a predefined set of development tools or agents in      \u001b[17;37H isolated tmux windows/panes and manage them through a centralized TUI (Terminal User Interface),      \u001b[18;37H while avoiding the common \"freezing\" and session-detection issues that occur when nesting tmux        \u001b[19;37H sessions.\u001b[K\u001b[20;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Key Architecture & Features\u001b(B\u001b[m\u001b[K\u001b[23;37H \u001b[38;2;210;150;31m\u001b[1m#### 1. Isolated Tmux Server Architecture\u001b(B\u001b[m\u001b[K\u001b[25;37H The most distinctive technical feature is the use of a \u001b[1mseparate tmux server\u001b(B\u001b[m. Instead of creating a    \u001b[26;37H session on the default tmux server, \u001b[38;2;203;142;168maot\u001b[39m uses the \u001b[38;2;203;142;168m-L\u001b[39m socket option to start a completely isolated tmux \u001b[27;37H server instance.\u001b[K\u001b[28;37H\u001b[K\n \u001b[38;2;170;160;153m────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[31;37H \u001b[38;2;203;141;168m⠴\u001b[39m \u001b[38;2;170;160;153mWorking\u001b[39m\u001b[K\u001b[33;37H\u001b[38;2;200;132;161m─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[34;37H\u001b(B\u001b[m\u001b[38;2;142;131;123m❯\u001b[39m \u001b[7m \u001b(B\u001b[m\u001b[K\u001b[35;37H\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[36;37H\u001b(B\u001b[m\u001b[38;2;95;175;95m⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m5.3%/128k (auto)\u001b[39m\u001b[K\u001b[37;37H\u001b[38;2;142;131;123mLSP Inactive\u001b[39m\u001b[K\u001b[34;39H"]
