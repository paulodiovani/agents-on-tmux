[0.004, "o", "\u001b[36;2H\u001b[1mC-a C-a\u001b(B\u001b[m\u001b[2m pr\u001b[Cfix\u001b(B\u001b[m  \u001b[1mc\u001b(B\u001b[m\u001b[2m ne\u001b[C\u001b(B\u001b[m \u001b[C\u001b[1mn\u001b(B\u001b[m\u001b[2m next\u001b(B\u001b[m  \u001b[37;2H\u001b[1mp\u001b[C\u001b(B\u001b[m\u001b[2mprev\u001b[C\u001b(B\u001b[m \u001b[1ml\u001b(B\u001b[m\u001b[2m last\u001b(B\u001b[m \u001b[C\u001b[1m,\u001b(B\u001b[m\u001b[2m rename\u001b[C\u001b(B\u001b[m      \u001b[34;39H"]
