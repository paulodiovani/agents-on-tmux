[0.188, "o", "\u001b[?25l\u001b[1;37H\u001b[K\n The project provides a TUI for interacting with the agents.\u001b[K\u001b[3;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTUI Interface:\u001b(B\u001b[m Built to be lightweight and theme-aware.\u001b[K\u001b[4;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mTheme Support:\u001b(B\u001b[m It uses ANSI color slots (0-15), ensuring the UI inherits the user's terminal colors \u001b[5;37H   rather than forcing a specific RGB palette.\u001b[K\u001b[6;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mControl Loop:\u001b(B\u001b[m The \u001b[38;2;203;142;168mApp\u001b[39m state manages user actions (mapped via \u001b[38;2;203;142;168mkey_to_action\u001b[39m) to trigger backend      \u001b[7;37H   changes (like restarting an agent or switching windows).\u001b[K\u001b[8;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### How it Works (Execution Flow)\u001b(B\u001b[m\u001b[K\u001b[10;37H\u001b[K\n \u001b[38;2;203;142;168m1. \u001b[39m\u001b[1mStart:\u001b(B\u001b[m The user runs \u001b[38;2;203;142;168maot\u001b[39m (or \u001b[38;2;203;142;168maot --tui\u001b[39m).\u001b[K\u001b[12;37H \u001b[38;2;203;142;168m2. \u001b[39m\u001b[1mEnvironment Setup:\u001b(B\u001b[m\u001b[K\u001b[13;37H     \u001b[38;2;203;142;168m- \u001b[39mIt detects if it's already inside its own isolated server to prevent infinite nesting.\u001b[K\u001b[14;37H     \u001b[38;2;203;142;168m- \u001b[39mIt creates the isolated tmux server/session if it doesn't exist.\u001b[K\u001b[15;37H \u001b[38;2;203;142;168m3. \u001b[39m\u001b[1mLaunch:\u001b(B\u001b[m\u001b[K\u001b[16;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWithout \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It splits a pane in the \u001b[3mparent\u001b(B\u001b[m session and attaches the user to the \u001b[3misolated\u001b(B\u001b[m     \u001b[17;37H       nested session.\u001b[K\u001b[18;37H     \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mWith \u001b[38;2;203;142;168m--tui\u001b[39m:\u001b(B\u001b[m It launches the TUI management interface directly.\u001b[K\u001b[19;37H \u001b[38;2;203;142;168m4. \u001b[39m\u001b[1mManagement:\u001b(B\u001b[m The user uses the TUI to spin up/down agents, which are then mapped to windows in the  \u001b[20;37H    isolated tmux server.\u001b[K\u001b[21;37H\u001b[K\n \u001b[38;2;210;150;31m\u001b[1m### Summary for Developers\u001b(B\u001b[m\u001b[K\u001b[23;37H\u001b[K\n \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mLanguage:\u001b(B\u001b[m Rust.\u001b[K\u001b[25;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mDesign Philosophy:\u001b(B\u001b[m Trait-based communication, strict separation between presentation (frontend) and \u001b[26;37H   logic (backend), and high testability via dependency injection.\u001b[K\u001b[27;37H \u001b[38;2;203;142;168m- \u001b[39m\u001b[1mConstraints:\u001b(B\u001b[m No logic in \u001b[38;2;203;142;168mmod.rs\u001b[39m, private-by-default visibility, and a preference for \u001b[38;2;203;142;168mstd\u001b[39m over       \u001b[28;37H   adding unnecessary external crates.\u001b[K\u001b[29;37H\u001b[K\u001b[38;2;200;132;161m\n─\u001b[39m \u001b[38;2;215;135;175mgemma4:31b-cloud\u001b(B\u001b[m\u001b[38;2;142;131;123m / \u001b(B\u001b[m\u001b[38;2;0;175;175magents-on-tmux \u001b(B\u001b[m\u001b[38;2;200;132;161m───────────────────────────────────────────────────────────────────\u001b[39m\u001b[38;2;142;131;123m\u001b[31;37H❯\u001b[39m\u001b[K\u001b[38;2;200;132;161m\u001b[32;37H───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[38;2;95;175;95m\u001b[33;37H⎇ feature/gh-pages \u001b(B\u001b[m\u001b[38;2;142;131;123m6.2%/128k (auto) ↑7.1k ↓774\u001b[39m\u001b[K\u001b[38;2;142;131;123m\u001b[34;37HLSP Inactive\u001b[39m\u001b[K\u001b[2m\u001b[35;37HTo resume this session:\u001b(B\u001b[m pi --session 01a14b8d-826f-7430-9cf7-f34189134b5f\u001b[K\u001b[40m\u001b[36;37H 🥑 \u001b[30m\u001b[44m agents-on-tmux \u001b[34m\u001b[46m\u001b[30m feature/gh-pages \u001b[33m\u001b[1m±\u001b(B\u001b[m\u001b[36m\u001b[39m\u001b[K\u001b[37;37H\u001b[K\u001b[?12l\u001b[?25h\u001b[2 q"]
[0.016, "o", "\u001b[1d\u001b[40m 🥑 \u001b[30m\u001b[44m agents-on-tmux \u001b[34m\u001b[46m\u001b[30m feature/gh-pages \u001b[33m\u001b[1m±\u001b(B\u001b[m\u001b[36m\u001b[39m ls\u001b[K\u001b[2;37H\u001b[35m\u001b[1m0\u001b(B\u001b[m          \u001b[34m\u001b[1massets\u001b(B\u001b[m      Cargo.toml    \u001b[34m\u001b[1mdocs\u001b(B\u001b[m     README.md    \u001b[34m\u001b[1msrc\u001b(B\u001b[m\u001b[K\u001b[3;37HAGENTS.md  Cargo.lock  CHANGELOG.md  LICENSE  Session.vim  \u001b[34m\u001b[1mtarget\u001b(B\u001b[m\u001b[K\u001b[4;37H\u001b[40m 🥑 \u001b[30m\u001b[44m agents-on-tmux \u001b[34m\u001b[46m\u001b[30m feature/gh-pages \u001b[33m\u001b[1m±\u001b(B\u001b[m\u001b[36m\u001b[39m\u001b[K\u001b[5;37H\u001b[K\n\u001b[K\n\u001b[K\u001b[2B\u001b[K\u001b[2B\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[2B\u001b[K\u001b[2B\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[2B\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[4;81H"]
